    "Parakeet Redux by Moondream, based on NVIDIA Parakeet TDT 0.6B v3 (CC-BY-4.0). Speech is recognized entirely on this Mac.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Redux от Moondream на основе NVIDIA Parakeet TDT 0.6B v3 (CC-BY-4.0). Речь распознаётся полностью на этом Mac."
          }
        }
      }
    },
    "Parakeet Redux, 178 MB, downloaded once.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Parakeet Redux, 178 МБ, загружается один раз."
