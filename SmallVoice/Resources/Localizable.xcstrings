      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель речи"
          }
        }
      }
    },
    "Speech recognition runs entirely on this Mac.\nModel: Parakeet Redux by Moondream, based on NVIDIA Parakeet TDT 0.6B v3 (CC-BY-4.0).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи работает полностью на этом Mac.\nМодель: Parakeet Redux от Moondream на основе NVIDIA Parakeet TDT 0.6B v3 (CC-BY-4.0)."
          }
        }
      }
    },
    "Start Dictating": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать"
          }
        }
      }
    },
    "Start Dictation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начать диктовку"
          }
        }
      }
