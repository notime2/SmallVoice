{
  "sourceLanguage": "en",
  "strings": {
    "%@ failed its integrity check": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не прошёл проверку целостности"
          }
        }
      }
    },
    "About SmallVoice": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О SmallVoice"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ"
          }
        }
      }
    },
    "Add a space when continuing a sentence": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставить пробел, если текст продолжается"
          }
        }
      }
    },
    "All set. Hold %@ and speak, then release to insert the text.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё готово. Удерживайте %@ и говорите, затем отпустите, и текст появится."
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить"
          }
        }
      }
    },
    "Allow microphone access in System Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к микрофону в Системных настройках"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено"
          }
        }
      }
    },
    "Allow…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить…"
          }
        }
      }
    },
    "Checking the speech model…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка модели речи…"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка…"
          }
        }
      }
    },
    "Clear Recent": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить недавние"
          }
        }
      }
    },
    "Continue Later": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить позже"
          }
        }
      }
    },
    "Copied - press ⌘V to paste": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировано - нажмите ⌘V, чтобы вставить"
          }
        }
      }
    },
    "Custom Shortcut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Своё сочетание"
          }
        }
      }
    },
    "Custom shortcut": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание клавиш"
          }
        }
      }
    },
    "Dictate into any app. Your voice is recognized on this Mac and never leaves it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктуйте в любом приложении. Речь распознаётся прямо на этом Mac и никуда не отправляется."
          }
        }
      }
    },
    "Dictation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктовка"
          }
        }
      }
    },
    "Downloading %lld%%": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка %lld%%"
          }
        }
      }
    },
    "Downloading the speech model… %lld%%": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка модели речи… %lld%%"
          }
        }
      }
    },
    "Finish Setup…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить настройку…"
          }
        }
      }
    },
    "Fn (🌐)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fn (🌐)"
          }
        }
      }
    },
    "For the shortcut and for typing the text where your cursor is.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для горячей клавиши и вставки текста туда, где стоит курсор."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные"
          }
        }
      }
    },
    "Hold %@ to dictate": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте %@, чтобы диктовать"
          }
        }
      }
    },
    "Hold the key while you speak and release it to insert the text. Tap it once to keep listening hands-free, and tap again to finish. Press Esc to cancel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте клавишу, пока говорите, и отпустите, чтобы вставить текст. Короткое нажатие включает запись без рук, повторное завершает её. Esc отменяет запись."
          }
        }
      }
    },
    "Input": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход"
          }
        }
      }
    },
    "Listening…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушаю…"
          }
        }
      }
    },
    "Loading the speech model…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка модели речи…"
          }
        }
