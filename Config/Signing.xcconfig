// Code signing and bundle identity for SmallVoice builds.
//
// By default builds are signed ad hoc ("Sign to Run Locally"), so no Apple developer account is
// needed. macOS then sees every rebuild as a new app and asks for Microphone and Accessibility
// access again. To keep those grants across rebuilds, copy Local.example.xcconfig to
// Local.xcconfig (ignored by git) and put your own team and bundle identifier there.

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
SMALLVOICE_BUNDLE_ID = io.github.notime2.SmallVoice

#include? "Local.xcconfig"
